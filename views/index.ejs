<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>311 Call Data</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />

  <!-- Styles -->
  <link rel="stylesheet" href="/styles.css" />

  <!-- Bootstrap Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

  <!-- Plotly.js -->
  <script src='https://cdn.plot.ly/plotly-3.0.1.min.js'></script>

</head>

<body>
  <div class="text-center .container-fluid w-100 p-4">

    <div class="row">
      <div class="col m-4">
        <h1>311 Call Volumes in Halifax</h1>
      </div>
    </div>


    <div class="row rowStyle mt-2">
      <!-- Chart column -->
      <div class="col-12 col-lg-8">
        <div class="chart-container align-items-start">
          <div id="chartPlotly" class="align-items-center" ></div>
        </div>
      </div>
  <!-- Form column -->
      <div class="col-12 col-lg-4 justify-content-center">

        <div class="row flex-row w-100">
          <form action="/" method="GET" class="d-flex align-items-start gap-2">
          <button type="submit" class="btn btn-primary w-100 mb-2 mt-2">View Call Summary</button>
        </form>
        <form action="/submit" method="POST" class="d-flex flex-column align-items-start gap-2">
          <label for="queueSelect" class="form-label fw-semibold">Select Call Category :</label>
          <select id="queueSelect" name="queueName" class="form-select w-100 btn-danger" required>
            <option value="" disabled <%= !selectedQueue ? 'selected' : '' %>>-- Select a category --</option>
            <% for (const queue in content) { %>
              <option value="<%= queue %>" <%= (selectedQueue && queue === selectedQueue) ? 'selected' : '' %>>
                <%= queue %>
              </option>
            <% } %>
          </select>
          <button type="submit" class="btn btn-primary w-100">Submit</button>
          <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#fullscreenModal">
              View Fullscreen
            </button>
        </form>
        </div>
        <div class="row" >
            <div class="text-center">
            <div class="modal fade" id="fullscreenModal" tabindex="-1" aria-labelledby="fullscreenModalLabel" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered modal-fullscreen">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">311 Call Volumes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <div id="fullscreenChart"></div>
                  </div>
                </div>
              </div>
          </div>
        </div>
        
      </div>
    </div>

    <script id="data-json" type="application/json">
      <%- JSON.stringify(dataChart || []) %>
    </script>

    <script>

      const data = JSON.parse(document.getElementById('data-json').textContent);
      data.forEach(trace => {
        trace.textinfo = 'none';
        trace.hoverinfo = 'label+value+percent';
        trace.textinfo = 'label+percent';
        trace.textposition = 'inside';
        trace.insidetextorientation = 'radial';
      }); 
      
      var layout = {
          title: {
            text: '311 Call Volumes'
          },
          legend: {
            orientation: 'v',      
            x: 1.02,               
            y: 1,
            xanchor: 'left',       
            yanchor: 'top',
            },
            };

      var config = {
        responsive: true,
        displayModeBar: true,
        displaylogo: false
      }
      Plotly.newPlot('chartPlotly', data, layout, config); 

      const fullscreenModal = document.getElementById('fullscreenModal');
      let modalLayout = {
          title: '311 Call Volumes',
          layout:{
            height : "80vh"
          },
          margin: { l: 0, r: 20, t: 0, b: 0 }
          };
          fullscreenModal.addEventListener('shown.bs.modal', () => {
        Plotly.newPlot('fullscreenChart', data, modalLayout, config);
      });
    </script>
</body>
</html>